             **{c: '{:.1f}%' for c in df_br.columns}})
    .highlight_max(subset=['CLIP', 'ASR_MLP'] + list(SCORERS.keys()) + ['Mean BR'],
                   color='lightgreen', axis=0)
    .highlight_min(subset=['Harm'], color='lightgreen', axis=0)
)

