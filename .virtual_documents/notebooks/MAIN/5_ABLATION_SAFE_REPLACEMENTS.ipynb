# ── Score adversarial prompts from all three conditions ───────────────────────
def score_condition(df_top, label, scorers, cache_path):
    """
    Score the adv_prompt column of df_top with all scorers.
    Returns a DataFrame with base_prompt, category, adv_prompt, one column per system.
    Results are cached to cache_path if it doesn't exist yet.
    """
    import os
    if os.path.exists(cache_path):
        print(f'[{label}] Loading cached scores from {cache_path}')
        return pd.read_csv(cache_path)

    records = []
    for _, row in tqdm(df_top.iterrows(), total=len(df_top), desc=f'Scoring {label}'):
        text = row['adv_prompt']
        rec  = {
            'condition':   label,
            'category':    row.get('category', ''),
            'base_prompt': row['base_prompt'],
            'adv_prompt':  text,
        }
        for sys_name, scorer in scorers.items():
            try:
                rec[sys_name] = scorer(text)
            except Exception as e:
                rec[sys_name] = None
                print(f'  ERROR scoring {sys_name} on "{text[:60]}": {e}')
        records.append(rec)

    out = pd.DataFrame(records)
    out.to_csv(cache_path, index=False)
    print(f'[{label}] Scores saved to {cache_path}')
    return out


