# Paper Section 4.4: adversarial detection → best combination:
#   Head 5 @ Layer 7,  Head 10 @ Layer 4,  Head 4 @ Layer 2,  Head 7 @ Layer 0
# Concatenated: 4 × 768 = 3072 → input_dim=3072
from src.moderation_clip import ModerationHeadMLP as _MHP
mlp_adv = _MHP(input_dim=3072, hidden_layer=2)
